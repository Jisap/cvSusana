---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cv } from '../data/cv';
---

<BaseLayout
  title={`${cv.name} — ${cv.headline}`}
  description={cv.summary}
>
  <SiteHeader />
  <main>
    <Hero />

    <Section
      id="perfil"
      eyebrow="Perfil"
      title="Atención personalizada, don de gentes y gestión del punto de venta."
    >
      <div class="grid gap-8 md:grid-cols-[1.5fr_1fr] md:gap-16">
        <p class="text-lg leading-relaxed text-ink-soft">
          Más de 20 años de vocación en el retail de moda: escuchando, asesorando
          y fidelizando clientes tanto en firmas de prestigio y corners en El Corte Inglés
          como al frente de la gestión integral de tiendas. Apasionada por el trato humano,
          el orden, el escaparatismo y el trabajo en equipo.
        </p>
        <ul class="space-y-3 border-t border-line pt-6 text-sm text-ink-soft md:border-l md:border-t-0 md:pl-8 md:pt-0">
          <li class="flex gap-3">
            <span class="text-accent">01</span>
            Venta activa, asesoramiento de imagen y fidelización.
          </li>
          <li class="flex gap-3">
            <span class="text-accent">02</span>
            Gestión de corners ECI, arqueos de caja, TPV y control de stock.
          </li>
          <li class="flex gap-3">
            <span class="text-accent">03</span>
            Liderazgo de equipos, formación interna y escaparatismo.
          </li>
        </ul>
      </div>
    </Section>

    <Section
      id="experiencia"
      eyebrow="Experiencia"
      title="Trayectoria profesional"
    >
      <Experience />
    </Section>

    <Section
      id="habilidades"
      eyebrow="Habilidades"
      title="Herramientas y capacidades"
    >
      <Skills />
    </Section>

    <Section
      id="formacion"
      eyebrow="Formación"
      title="Estudios e idiomas"
    >
      <Education />
    </Section>
  </main>
  <SiteFooter />
</BaseLayout>
