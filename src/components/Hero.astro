---
import { cv } from "../data/cv";
---

<section id="top" class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 right-[-6rem] h-[28rem] w-[28rem] rounded-full bg-accent-soft blur-3xl opacity-80"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-[-10rem] left-[-8rem] h-80 w-80 rounded-full bg-surface-muted blur-3xl"
  >
  </div>

  <div
    class="relative mx-auto grid max-w-5xl gap-12 px-6 py-20 md:grid-cols-[1.35fr_1fr] md:items-center md:py-28"
  >
    <div>
      <p
        class="inline-flex items-center gap-2 rounded-full border border-line bg-surface-muted px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-ink-soft"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        {cv.available}
      </p>

      <h1
        class="mt-6 font-display text-5xl leading-[1.02] tracking-tight sm:text-6xl"
      >
        {cv.name}
      </h1>

      <p class="mt-4 text-xl font-medium text-accent">{cv.headline}</p>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
        {cv.summary}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="/cv"
          class="rounded-full bg-ink px-6 py-3 text-sm font-medium text-surface transition-colors hover:bg-accent hover:text-accent-ink"
        >
          Ver CV en PDF
        </a>
        <a
          href={`mailto:${cv.email}`}
          class="rounded-full border border-line px-6 py-3 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
        >
          Contactar
        </a>
      </div>

      <ul class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        {
          cv.links.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noreferrer noopener"
                class="group inline-flex items-center gap-1 text-ink-soft transition-colors hover:text-accent"
              >
                {link.label}
                <span
                  aria-hidden="true"
                  class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                >
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <aside
      class="group relative overflow-hidden rounded-3xl border border-line bg-surface-muted/60 p-5 shadow-sm backdrop-blur transition-all duration-300 hover:shadow-md sm:p-6"
    >
      <div
        class="relative mx-auto aspect-[4/5] w-full overflow-hidden rounded-2xl bg-surface-muted shadow-inner"
      >
        <img
          src="/susana.jpg"
          alt={`Retrato profesional de ${cv.name}`}
          width="480"
          height="600"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover object-[center_20%] transition-transform duration-500 group-hover:scale-[1.02]"
        />
        <div
          class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/60 to-transparent pb-4 pt-12 px-4 text-white sm:pb-5 sm:px-5"
        >
          <p
            class="text-[0.72rem] font-bold uppercase tracking-[0.2em] text-white/90 drop-shadow-sm flex items-center gap-1.5"
          >
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            {cv.location}
          </p>
          <p class="mt-0.5 font-display text-xl font-medium tracking-tight text-white drop-shadow-sm sm:text-2xl">
            {cv.name}
          </p>
        </div>
      </div>

      <div class="mt-5 space-y-3 text-sm">
        <div
          class="flex items-center justify-between border-b border-line/70 pb-2.5"
        >
          <span class="text-ink-soft">Teléfono</span>
          <a
            class="font-medium hover:text-accent"
            href={`tel:${cv.phone.replace(/\s/g, "")}`}
          >
            {cv.phone}
          </a>
        </div>
        <div
          class="flex items-center justify-between border-b border-line/70 pb-2.5"
        >
          <span class="text-ink-soft">Email</span>
          <a class="font-medium hover:text-accent" href={`mailto:${cv.email}`}>
            {cv.email}
          </a>
        </div>
        <div class="flex items-center justify-between pt-0.5">
          <span class="text-ink-soft">Idiomas</span>
          <span class="font-medium">
            {cv.languages.map((language) => language.name).join(" · ")}
          </span>
        </div>
      </div>
    </aside>
  </div>

  <div class="relative border-y border-line bg-surface-muted/40">
    <dl class="mx-auto grid max-w-5xl grid-cols-3 divide-x divide-line px-6">
      {
        cv.stats.map((stat) => (
          <div class="px-4 py-7 text-center first:pl-0 last:pr-0 sm:px-8">
            <dd class="font-display text-3xl tracking-tight text-ink sm:text-4xl">
              {stat.value}
            </dd>
            <dt class="mt-1 text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-ink-soft sm:text-xs">
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
