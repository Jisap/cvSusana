---
import { cv } from '../data/cv';
---

<ol class="divide-y divide-line border-t border-line">
  {
    cv.experience.map((job) => (
      <li class="grid gap-4 py-9 first:pt-9 md:grid-cols-[11rem_1fr] md:gap-10">
        <div class="text-sm leading-relaxed text-ink-soft">
          <p class="font-medium text-ink">
            {job.start} — {job.end}
          </p>
          <p>{job.location}</p>
        </div>

        <div>
          <h3 class="text-lg font-semibold tracking-tight">{job.role}</h3>
          <p class="text-sm font-medium text-accent">{job.company}</p>

          {job.summary && (
            <p class="mt-3 leading-relaxed text-ink-soft">{job.summary}</p>
          )}

          {job.condensed && !job.bullets.length && (
            <p class="mt-3 leading-relaxed text-ink-soft">{job.condensed}</p>
          )}

          {job.bullets.length > 0 && (
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-ink-soft">
              {job.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span
                    aria-hidden="true"
                    class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"
                  />
                  <span>{bullet.text}</span>
                </li>
              ))}
            </ul>
          )}

          {job.tags && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {job.tags.map((tag) => (
                <li class="rounded-full border border-line bg-surface-muted/60 px-3 py-1 text-xs text-ink-soft">
                  {tag}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>
