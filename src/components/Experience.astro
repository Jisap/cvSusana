---
import { cv } from '../data/cv';
---

<div class="relative border-l border-line/80 ml-2 pl-6 sm:ml-4 sm:pl-10 space-y-12">
  {
    cv.experience.map((job) => {
      const isCurrent = job.end.toLowerCase().includes('presente') || job.end.toLowerCase().includes('actual');
      const isLead = job.role.toLowerCase().includes('responsable') || job.role.toLowerCase().includes('encargada');

      return (
        <article class="relative group">
          <!-- Indicador en la línea de tiempo -->
          <div
            class={`absolute -left-[31px] sm:-left-[47px] top-1.5 h-3.5 w-3.5 rounded-full border-2 border-surface transition-transform duration-300 group-hover:scale-125 ${
              isCurrent ? 'bg-accent shadow-[0_0_0_4px_rgba(14,107,92,0.15)]' : 'bg-line group-hover:bg-accent'
            }`}
            aria-hidden="true"
          />

          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="font-display text-2xl tracking-tight text-ink">
                {job.role}
              </h3>
              {isCurrent && (
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse" />
                  Actual
                </span>
              )}
              {isLead && !isCurrent && (
                <span class="text-xs uppercase tracking-widest text-ink-soft/80 font-medium">
                  Dirección
                </span>
              )}
            </div>

            <p class="font-mono text-xs tracking-wider text-ink-soft shrink-0">
              {job.start} — {job.end}
            </p>
          </div>

          <p class="mt-1 text-base font-medium text-accent">
            {job.company} <span class="text-ink-soft/40 font-normal">· {job.location}</span>
          </p>

          {job.summary && (
            <p class="mt-3 text-base leading-relaxed text-ink-soft max-w-3xl">
              {job.summary}
            </p>
          )}

          {job.condensed && !job.bullets.length && (
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              {job.condensed}
            </p>
          )}

          {job.bullets.length > 0 && (
            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-ink-soft max-w-3xl">
              {job.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span
                    aria-hidden="true"
                    class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent/60"
                  />
                  <span>{bullet.text}</span>
                </li>
              ))}
            </ul>
          )}

          {job.tags && job.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-soft/70">
              {job.tags.map((tag) => (
                <span class="before:content-['#'] before:mr-0.5 before:text-accent/60">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      );
    })
  }
</div>
