---
import { cv } from '../data/cv';
---

<div class="space-y-6">
  {
    cv.experience.map((job) => {
      const isCurrent = job.end.toLowerCase().includes('presente') || job.end.toLowerCase().includes('actual');
      const isECI = job.company.toLowerCase().includes('corte inglés') || job.tags?.some(t => t.toLowerCase().includes('corte inglés'));
      const isLead = job.role.toLowerCase().includes('responsable') || job.role.toLowerCase().includes('encargada');

      return (
        <article class="group relative rounded-2xl border border-line bg-surface p-6 transition-all duration-300 hover:border-accent/50 hover:shadow-sm sm:p-7">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-xl font-semibold tracking-tight text-ink">
                  {job.role}
                </h3>
                {isCurrent && (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent">
                    <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse" />
                    Puesto actual
                  </span>
                )}
                {isLead && !isCurrent && (
                  <span class="inline-flex items-center rounded-full bg-surface-muted px-2.5 py-0.5 text-xs font-semibold text-ink-soft">
                    Dirección de tienda
                  </span>
                )}
              </div>

              <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                <span class="font-medium text-accent">
                  {job.company}
                </span>
                <span class="text-line" aria-hidden="true">·</span>
                <span class="text-ink-soft">
                  {job.location}
                </span>
                {isECI && (
                  <span class="rounded bg-surface-muted/90 px-2 py-0.5 text-[0.7rem] font-semibold tracking-wide text-ink-soft">
                    ECI
                  </span>
                )}
              </div>
            </div>

            <div class="shrink-0 text-sm font-medium text-ink-soft sm:text-right">
              <span class="rounded-lg border border-line/60 bg-surface-muted/40 px-3 py-1">
                {job.start} — {job.end}
              </span>
            </div>
          </div>

          {job.summary && (
            <p class="mt-4 text-base leading-relaxed text-ink-soft">
              {job.summary}
            </p>
          )}

          {job.condensed && !job.bullets.length && (
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">
              {job.condensed}
            </p>
          )}

          {job.bullets.length > 0 && (
            <ul class="mt-5 space-y-2.5 text-sm leading-relaxed text-ink-soft">
              {job.bullets.map((bullet) => (
                <li class="flex gap-3">
                  <span
                    aria-hidden="true"
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent/70"
                  />
                  <span>{bullet.text}</span>
                </li>
              ))}
            </ul>
          )}

          {job.tags && job.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2 border-t border-line/60 pt-4">
              {job.tags.map((tag) => (
                <span class="rounded-full border border-line bg-surface-muted/60 px-3 py-1 text-xs text-ink-soft transition-colors group-hover:border-line">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      );
    })
  }
</div>
