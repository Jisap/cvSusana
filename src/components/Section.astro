---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl px-6 py-16 md:py-20">
  <div class="max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-accent">
      {eyebrow}
    </p>
    <h2 class="mt-3 font-display text-3xl tracking-tight md:text-4xl">
      {title}
    </h2>
  </div>
  <div class="mt-10">
    <slot />
  </div>
</section>
