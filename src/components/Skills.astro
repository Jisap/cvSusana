---
import { cv } from '../data/cv';
---

<ul class="grid gap-5 sm:grid-cols-2">
  {
    cv.skills.map((skill) => (
      <li class="rounded-2xl border border-line bg-surface-muted/50 p-6">
        <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-ink">
          {skill.group}
        </h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {skill.items.map((item) => (
            <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm text-ink-soft">
              {item}
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>
