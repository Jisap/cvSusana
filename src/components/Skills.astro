---
import { cv } from '../data/cv';
---

<div class="space-y-12">
  {
    cv.skills.map((skill) => {
      const isSoftware = skill.group.toLowerCase().includes('herramienta');

      return (
        <div class="border-t border-line/70 pt-6">
          <div class="grid gap-6 md:grid-cols-[14rem_1fr] md:gap-12">
            <div>
              <h3 class="font-display text-xl tracking-tight text-ink">
                {skill.group}
              </h3>
              {isSoftware && (
                <p class="mt-1 text-xs uppercase tracking-widest text-accent">
                  Diseño & Ofimática
                </p>
              )}
            </div>

            <ul class="flex flex-wrap gap-x-6 gap-y-3 text-base text-ink-soft">
              {skill.items.map((item) => (
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent/60" aria-hidden="true" />
                  <span class="transition-colors hover:text-ink">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })
  }
</div>
